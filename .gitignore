# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tests and tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
config/models.local.json

# Runtime data
data/local/
# 服务端保存的模型连接：里面有明文 API Key，只留在本机运行目录里。
# 用 TRACEGRAPH_MODEL_CONNECTIONS 把它挪到别处时，记得自己把新位置也忽略掉。
data/local/model-connections.json
# 上传原件的落盘目录：里面是用户上传的真实文档，绝不能进版本库
data/workspaces/
logs/
*.log

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
