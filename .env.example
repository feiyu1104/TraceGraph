# 未设置环境变量时回退到 SQLite；使用 Neo4j 时安装 tracegraph[graph]
TRACEGRAPH_DATABASE=data/local/tracegraph.db
TRACEGRAPH_GRAPH_BACKEND=sqlite
# none：Neo4j 连不上就直接失败；sqlite：显式同意降级，并把降级写进 /system
TRACEGRAPH_GRAPH_FALLBACK=none
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Windows ZIP 安装可设置；Linux/macOS 或容器部署可以留空
JAVA_HOME=
NEO4J_HOME=

# ---- 单模型模式（没有 config/models.local.json 时生效）----
# 生成器：extractive（离线摘录，默认，不需要任何外部服务）
#         openai-compatible（任意提供 /chat/completions 的服务）
TRACEGRAPH_GENERATOR=extractive

# TRACEGRAPH_GENERATOR=openai-compatible 时三项都必须填写，否则启动直接失败。
# BASE_URL 填到服务根路径即可，不要带 /chat/completions；不要在这里写死厂商域名。
TRACEGRAPH_LLM_BASE_URL=
TRACEGRAPH_LLM_API_KEY=
TRACEGRAPH_LLM_MODEL=

# 连接与响应超时，单位秒
TRACEGRAPH_LLM_TIMEOUT=45

# ---- 多模型模式（存在 config/models.local.json 时，它决定可选模型与默认模型）----
# 模型清单文件路径；留空则用 config/models.local.json
TRACEGRAPH_MODELS_CONFIG=
# 清单里每个模型的 api_key_env 指向的环境变量，密钥只写在这里，不写进清单文件：
# TRACEGRAPH_MAIN_MODEL_API_KEY=
# TRACEGRAPH_FAST_MODEL_API_KEY=

# none（默认，模型失败就让请求失败）
# extractive（显式同意模型失败后降级为离线摘录，降级会写进 /system 与 metrics）
TRACEGRAPH_LLM_FALLBACK=none

# ---- 上传限制 ----
# 单次上传的文档大小上限，单位 MiB；超限返回 HTTP 413 与 file_too_large
TRACEGRAPH_MAX_UPLOAD_MB=10
